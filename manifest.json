{
  "manifest_version": 3,
  "name": "Privacy-Preserving Website Blocker",
  "version": "1.0",
  "description": "Local-first website blocker.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}